.container {
  min-height: 100vh;
  padding: 40rpx;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.04);
}

.praise {
  display: block;
  margin-bottom: 24rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #1f7a5c;
}

.row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 16rpx 0;
}

.label {
  font-size: 26rpx;
  color: #888;
}

.big {
  font-size: 48rpx;
  font-weight: 700;
  color: #222;
}

.age-num {
  color: #1f7a5c;
}

.good {
  color: #1f7a5c;
}

.warn {
  color: #e07b39;
  font-size: 36rpx;
}

.desc {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #999;
}

.divider {
  height: 1rpx;
  background: #f0f0f0;
  margin: 16rpx 0;
}

.progress-wrap {
  padding: 20rpx 0 8rpx;
}

.progress-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.progress-label {
  font-size: 24rpx;
  color: #888;
}

.progress-num {
  font-size: 26rpx;
  font-weight: 700;
  color: #1f7a5c;
}

.progress-bar {
  height: 16rpx;
  background: #edf3f1;
  border-radius: 8rpx;
  margin: 14rpx 0 12rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #2f9b76, #1f7a5c);
  border-radius: 8rpx;
}

.progress-desc {
  font-size: 22rpx;
  color: #aaa;
}

.primary-btn {
  width: 100%;
  margin-top: 48rpx;
  background: #1f7a5c;
  color: #fff;
  border-radius: 48rpx;
  font-size: 32rpx;
  padding: 24rpx 0;
}

.ghost-btn {
  width: 100%;
  margin-top: 24rpx;
  background: #fff;
  color: #1f7a5c;
  border: 1rpx solid #1f7a5c;
  border-radius: 48rpx;
  font-size: 32rpx;
  padding: 24rpx 0;
}

.tip {
  display: block;
  margin-top: 32rpx;
  text-align: center;
  font-size: 22rpx;
  color: #aaa;
}

.soothe {
  display: block;
  margin-top: 12rpx;
  text-align: center;
  font-size: 22rpx;
  color: #bbb;
}
