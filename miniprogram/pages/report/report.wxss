.container {
  min-height: 100vh;
  padding: 40rpx;
}

.report-card {
  background: linear-gradient(160deg, #1f7a5c, #2f9b76);
  border-radius: 24rpx;
  padding: 56rpx 40rpx;
  color: #fff;
  box-shadow: 0 16rpx 40rpx rgba(31, 122, 92, 0.28);
}

.report-title {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
}

.line {
  height: 2rpx;
  background: rgba(255, 255, 255, 0.35);
  margin: 28rpx 0;
}

.report-body {
  font-size: 30rpx;
  line-height: 1.8;
  color: rgba(255, 255, 255, 0.95);
}

.quote {
  display: block;
  font-size: 26rpx;
  line-height: 1.7;
  color: rgba(255, 255, 255, 0.75);
}

.actions {
  margin-top: 56rpx;
}

.primary-btn {
  width: 100%;
  background: #1f7a5c;
  color: #fff;
  border-radius: 48rpx;
  font-size: 32rpx;
  padding: 24rpx 0;
}

.ghost-btn {
  width: 100%;
  margin-top: 24rpx;
  background: #fff;
  color: #1f7a5c;
  border: 1rpx solid #1f7a5c;
  border-radius: 48rpx;
  font-size: 32rpx;
  padding: 24rpx 0;
}

.tip {
  display: block;
  margin-top: 32rpx;
  text-align: center;
  font-size: 22rpx;
  color: #aaa;
}
