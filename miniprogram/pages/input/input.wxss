.container {
  min-height: 100vh;
  padding: 40rpx;
}

.field {
  margin-bottom: 40rpx;
}

.label {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.inp {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 32rpx;
  font-size: 32rpx;
}

.rates {
  display: flex;
  gap: 20rpx;
}

.rate {
  flex: 1;
  text-align: center;
  background: #fff;
  border-radius: 12rpx;
  padding: 22rpx 0;
  font-size: 28rpx;
  color: #555;
}

.rate.active {
  background: #1f7a5c;
  color: #fff;
}

.primary-btn {
  width: 100%;
  margin-top: 24rpx;
  background: #1f7a5c;
  color: #fff;
  border-radius: 48rpx;
  font-size: 32rpx;
  padding: 24rpx 0;
}

.tip {
  display: block;
  margin-top: 32rpx;
  text-align: center;
  font-size: 22rpx;
  color: #aaa;
}
